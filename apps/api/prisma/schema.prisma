generator client {
  provider = "prisma-client-js"
  output   = "../src/db/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenants ──────────────────────────────────────────────────────────────────

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  plan   TenantPlan   @default(FREE)
  status TenantStatus @default(ACTIVE)

  // Branding (white-label support)
  logoUrl       String?
  primaryColor  String? @default("#6366F1")
  companyName   String?
  emailFrom     String?
  emailFromName String?

  // Twilio config (encrypted at app layer)
  twilioAccountSid  String?
  twilioAuthToken   String? // AES encrypted
  twilioPhoneNumber String?

  // WhatsApp config
  whatsappAccessToken   String? // AES encrypted
  whatsappPhoneNumberId String?

  // Vapi (AI calling) config
  vapiApiKey        String? // AES encrypted
  vapiPhoneNumberId String?

  // Agent floor / presence config
  inactivityTimeoutMinutes Int? @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  contacts           Contact[]
  deals              Deal[]
  dealStages         DealStage[]
  calls              Call[]
  messages           Message[]
  messageTemplates   MessageTemplate[]
  workflows          Workflow[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  onboarding         OnboardingProgress?
  integrations       Integration[]
  tasks              Task[]
  campaigns          Campaign[]
  marketingLists     MarketingList[]
  marketingCampaigns MarketingCampaign[]
  scoringRules       ScoringRule[]
  customFields       CustomFieldDefinition[]
  pipelines          Pipeline[]
  callDispositions   CallDisposition[]
  reportSchedules    ReportSchedule[]
  breakWindows       BreakWindow[]
  agentPresences     AgentPresence[]
  agentBreakLogs     AgentBreakLog[]
  notifications      Notification[]
  programs           Program[]
  applications       Application[]
  emailConfig        EmailConfig?
  rolePermissions    RolePermission[]
  broadcasts         Broadcast[]
  aiCallAgents       AiCallAgent[]
  leadLists          LeadList[]
  reProjects            Project[]
  reUnits               Unit[]
  reSiteVisits          SiteVisit[]
  reBookings            Booking[]
  rePropertyPreferences PropertyPreference[]
  reStageHistories      RealEstateStageHistory[]
  rePartners            Partner[]
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(AGENT)
  status       UserStatus @default(ACTIVE)
  phone        String?
  avatarUrl    String?

  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities       Activity[]
  auditLogs        AuditLog[]
  calls            Call[]          @relation("AssignedAgent")
  tasksAssigned    Task[]          @relation("TaskAssignee")
  contactsAssigned Contact[]       @relation("ContactAssignee")
  notifications    Notification[]
  agentPresence    AgentPresence?
  breakLogs        AgentBreakLog[]
  broadcastsCreated Broadcast[]
  reSiteVisitsAsAgent SiteVisit[] @relation("SiteVisitAgent")
  reBookingsAsAgent   Booking[]   @relation("BookingAgent")

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

// ─── Super Admin ──────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  impersonationLogs ImpersonationLog[]
}

model ImpersonationLog {
  id           String  @id @default(cuid())
  superAdminId String
  tenantId     String
  userId       String?
  action       String
  metadata     Json?
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([tenantId])
  @@index([createdAt])
}

// ─── Contacts ─────────────────────────────────────────────────────────────────

model Contact {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String
  alternatePhone String?
  whatsapp       String?
  company      String?
  jobTitle     String?
  status       ContactStatus       @default(LEAD)
  temperature  ContactTemperature?
  source       String?
  tags         String[]
  customFields Json?
  assignedToId String?
  campaignId   String?
  score        Int                 @default(0)

  // Real Estate vertical: nullable so contacts outside this vertical are unaffected.
  // Lives directly on Contact (not a join table) — it's a single current value per
  // contact, same pattern as campaignId/score, not a many-relation that needs its own table.
  realEstateStage RealEstateLeadStage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        Campaign?             @relation(fields: [campaignId], references: [id])
  assignedTo      User?                 @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals           Deal[]
  calls           Call[]
  messages        Message[]
  activities      Activity[]
  tasks           Task[]
  applications    Application[]
  listMemberships MarketingListMember[]
  leadListMemberships LeadListMember[]
  reSiteVisits          SiteVisit[]
  reBookings            Booking[]
  rePropertyPreference  PropertyPreference?
  reStageHistory        RealEstateStageHistory[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, campaignId])
  @@index([tenantId, score])
  @@index([tenantId, assignedToId])
  @@index([tenantId, realEstateStage])
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
  BLOCKED
}

enum ContactTemperature {
  HOT
  WARM
  COLD
}

// ─── Deal Stages ──────────────────────────────────────────────────────────────

model DealStage {
  id          String  @id @default(cuid())
  tenantId    String
  pipelineId  String?
  name        String
  order       Int
  probability Int     @default(0)
  color       String?
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline         Pipeline?         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals            Deal[]
  callDispositions CallDisposition[]

  @@unique([tenantId, order])
  @@index([tenantId])
  @@index([tenantId, pipelineId])
}

// ─── Pipelines ────────────────────────────────────────────────────────────────

model Pipeline {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages    DealStage[]
  campaigns Campaign[]

  @@index([tenantId])
}

// ─── Deals ────────────────────────────────────────────────────────────────────

model Deal {
  id                String    @id @default(cuid())
  tenantId          String
  contactId         String
  stageId           String
  title             String
  value             Decimal?  @db.Decimal(15, 2)
  currency          String    @default("INR")
  expectedCloseDate DateTime?
  assignedToId      String?
  closedAt          DateTime?
  isWon             Boolean?
  lostReason        String?
  customFields      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id])
  stage      DealStage  @relation(fields: [stageId], references: [id])
  activities Activity[]

  @@index([tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, contactId])
}

// ─── Activities ───────────────────────────────────────────────────────────────

model Activity {
  id         String       @id @default(cuid())
  tenantId   String
  contactId  String?
  dealId     String?
  userId     String
  type       ActivityType
  subject    String
  body       String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@index([tenantId, occurredAt])
}

enum ActivityType {
  CALL
  SMS
  WHATSAPP
  EMAIL
  NOTE
  MEETING
  TASK
  DEAL_STAGE_CHANGED
  CONTACT_CREATED
  DEAL_CREATED
}

// ─── Calls ────────────────────────────────────────────────────────────────────

model Call {
  id              String        @id @default(cuid())
  tenantId        String
  contactId       String?
  agentId         String?
  provider        String        @default("twilio")
  providerCallSid String?       @unique
  direction       CallDirection
  status          CallStatus    @default(INITIATED)
  fromNumber      String
  toNumber        String
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?
  recordingUrl    String?
  recordingSid    String?
  transcription   String?
  isAiInitiated   Boolean       @default(false)
  notes           String?
  dispositionId   String?
  aiAgentId       String?

  // AI end-of-call analysis (populated from Vapi webhook)
  aiSuccessEvaluation Boolean?
  aiSummary           String?
  cost                Float?   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact?         @relation(fields: [contactId], references: [id])
  agent       User?            @relation("AssignedAgent", fields: [agentId], references: [id])
  disposition CallDisposition? @relation(fields: [dispositionId], references: [id])
  aiAgent     AiCallAgent?     @relation(fields: [aiAgentId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, agentId])
  @@index([tenantId, contactId])
  @@index([tenantId, dispositionId])
  @@index([tenantId, aiAgentId])
  @@index([providerCallSid])
}

// ─── AI Calling (Vapi voice agents) ────────────────────────────────────────────

model AiCallAgent {
  id               String              @id @default(cuid())
  tenantId         String
  name             String
  language         String              @default("English")
  category         String              @default("General")
  description      String?
  callDirection    CallDirection       @default(OUTBOUND)
  greeting         String
  systemPrompt     String              @db.Text
  voiceId          String?
  vapiAssistantId  String?
  status           AiAgentStatus       @default(ACTIVE)

  // System Prompt & Rules (composed into the effective Vapi system prompt)
  scriptSteps           Json? // string[]
  knowledgeBase         Json? // { topic: string; content: string }[]
  pricingResponse       String?
  notInterestedResponse String?
  escalationRules       String?
  forbiddenTopics       String?
  behavioralRules       String?
  faqs                  Json? // { question: string; answer: string }[]

  // Closing & Hangup
  closingMessage      String?
  maxCallDurationSec  Int?    @default(300)
  dailyCallLimit      Int?    @default(100)
  customHangupLogic   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls  Call[]

  @@index([tenantId])
}

enum AiAgentStatus {
  ACTIVE
  PAUSED
}

// ─── Lead Lists (CSV/Excel uploads for AI Calling) ─────────────────────────────

model LeadList {
  id             String @id @default(cuid())
  tenantId       String
  name           String
  sourceFileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members LeadListMember[]

  @@index([tenantId])
}

model LeadListMember {
  id        String   @id @default(cuid())
  listId    String
  contactId String
  createdAt DateTime @default(now())

  list    LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELLED
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  contactId         String?
  agentId           String?
  templateId        String?
  broadcastId       String?
  channel           MessageChannel
  provider          String
  providerMessageId String?
  direction         MessageDirection
  status            MessageStatus    @default(PENDING)
  fromNumber        String
  toNumber          String
  body              String
  mediaUrl          String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact?         @relation(fields: [contactId], references: [id])
  template  MessageTemplate? @relation(fields: [templateId], references: [id])
  broadcast Broadcast?       @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([tenantId, contactId])
  @@index([tenantId, status])
  @@index([tenantId, broadcastId])
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Message Templates ────────────────────────────────────────────────────────

model MessageTemplate {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  channel       MessageChannel
  subject       String? // used for EMAIL channel
  body          String
  variables     String[]
  isActive      Boolean        @default(true)
  isDlt         Boolean        @default(false) // India TRAI DLT-registered SMS template
  dltTemplateId String? // DLT registration ID for the template
  dltSenderId   String? // DLT-registered sender header (e.g. "LEADSZ")
  isAiGenerated Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   Message[]
  broadcasts Broadcast[]

  @@index([tenantId])
  @@index([tenantId, channel])
}

// ─── Email Setup ──────────────────────────────────────────────────────────────

model EmailConfig {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  provider        String  @default("SES") // SES | SMTP
  sendingDomain   String?
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPasswordEnc String? // AES encrypted
  isVerified      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Workflows ────────────────────────────────────────────────────────────────

model Workflow {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean @default(false)

  // { type: "INCOMING_CALL" | "MESSAGE_RECEIVED" | "DEAL_STAGE_CHANGED" | "SCHEDULE", config: {} }
  trigger Json

  // [{ id, type: "SEND_SMS" | "SEND_WHATSAPP" | "SCHEDULE_CALL" | "CREATE_TASK" | "WEBHOOK", config: {}, nextStepId: string | null }]
  steps Json

  runCount  Int       @default(0)
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model WorkflowExecution {
  id           String                  @id @default(cuid())
  tenantId     String
  workflowId   String
  status       WorkflowExecutionStatus @default(RUNNING)
  triggerData  Json?
  currentStep  String?
  result       Json?
  errorMessage String?
  startedAt    DateTime                @default(now())
  completedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@index([tenantId, status])
}

enum WorkflowExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, resource])
  @@index([tenantId, userId])
  @@index([createdAt])
}

// ─── Integrations ─────────────────────────────────────────────────────────────

model Integration {
  id       String  @id @default(cuid())
  tenantId String
  type     String
  isActive Boolean @default(false)
  config   Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

// ─── Onboarding ───────────────────────────────────────────────────────────────

model OnboardingProgress {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  addedFirstContact    Boolean   @default(false)
  connectedTwilio      Boolean   @default(false)
  madeFirstCall        Boolean   @default(false)
  createdFirstWorkflow Boolean   @default(false)
  sentFirstMessage     Boolean   @default(false)
  completedAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id           String     @id @default(cuid())
  tenantId     String
  contactId    String?
  dealId       String?
  title        String
  description  String?
  assignedToId String
  dueDate      DateTime
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id])
  assignedTo User     @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, dueDate])
  @@index([tenantId, contactId])
}

enum TaskStatus {
  PENDING
  COMPLETED
}

// ─── Campaigns (acquisition) ───────────────────────────────────────────────────

model Campaign {
  id             String                    @id @default(cuid())
  tenantId       String
  name           String
  category       String?
  source         String?
  status         CampaignStatus            @default(ACTIVE)
  priority       CampaignPriority          @default(MEDIUM)
  duplicateCheck CampaignDuplicateCheck    @default(MOBILE_ONLY)
  assignmentRule CampaignAssignmentRule    @default(MANUAL)
  pipelineId     String?
  isPinned       Boolean                   @default(false)

  // Public lead-capture link: POST /api/v1/webhooks/integrate/:leadWebhookToken/leads
  // maps a landing-page form straight to this campaign — no field inside the
  // form's payload has to identify the campaign, the token in the URL does.
  leadWebhookToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  broadcasts Broadcast[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignPriority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignDuplicateCheck {
  NONE
  MOBILE_ONLY
  EMAIL_ONLY
  BOTH
}

enum CampaignAssignmentRule {
  MANUAL
  ROUND_ROBIN
}

// ─── WhatsApp Broadcasts ────────────────────────────────────────────────────

model Broadcast {
  id             String                  @id @default(cuid())
  tenantId       String
  name           String
  templateId     String?
  audienceSource BroadcastAudienceSource @default(CAMPAIGN)
  campaignId     String?
  statusFilter   ContactStatus?
  audienceCount  Int                     @default(0)
  status         BroadcastStatus         @default(DRAFT)
  createdById    String
  failureReason  String?
  sentAt         DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  MessageTemplate? @relation(fields: [templateId], references: [id])
  campaign  Campaign?        @relation(fields: [campaignId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  messages  Message[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum BroadcastAudienceSource {
  CAMPAIGN
  STATUS
  ALL
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

// ─── Marketing (bulk lists, separate from acquisition Campaigns) ──────────────

model MarketingList {
  id       String   @id @default(cuid())
  tenantId String
  name     String
  tags     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   MarketingListMember[]
  campaigns MarketingCampaign[]

  @@index([tenantId])
}

model MarketingListMember {
  id        String   @id @default(cuid())
  listId    String
  contactId String
  createdAt DateTime @default(now())

  list    MarketingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
}

model MarketingCampaign {
  id          String                  @id @default(cuid())
  tenantId    String
  listId      String
  name        String
  channel     MessageChannel
  templateId  String?
  status      MarketingCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentCount   Int                     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list   MarketingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ─── Scoring Rules ──────────────────────────────────────────────────────────────

model ScoringRule {
  id       String  @id @default(cuid())
  tenantId String
  field    String // e.g. "source", "customFields.course", "status"
  operator String // "equals" | "contains" | "gt" | "lt"
  value    String
  points   Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Custom Fields ────────────────────────────────────────────────────────────

model CustomFieldDefinition {
  id       String            @id @default(cuid())
  tenantId String
  entity   CustomFieldEntity @default(CONTACT)
  name     String
  key      String // slug used as the customFields JSON key
  type     CustomFieldType   @default(TEXT)
  options  String[]
  isActive Boolean           @default(true)
  order    Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, key])
  @@index([tenantId])
}

enum CustomFieldEntity {
  CONTACT
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  DATE
  BOOLEAN
}

// ─── Call Dispositions ──────────────────────────────────────────────────────────

model CallDisposition {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  category       String // e.g. "Not Connected", "Connected", "Follow Up"
  movesToStageId String?
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movesToStage DealStage? @relation(fields: [movesToStageId], references: [id])
  calls        Call[]

  @@index([tenantId])
}

// ─── Report Schedules ─────────────────────────────────────────────────────────

model ReportSchedule {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  reportKeys     String[] // e.g. ["call-disposition", "sms", "email"]
  frequency      String    @default("DAILY") // DAILY | WEEKLY | MONTHLY
  timeOfDay      String    @default("19:00") // HH:mm
  recipientEmail String
  isActive       Boolean   @default(true)
  lastSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Agent Floor / Break Tracking ──────────────────────────────────────────────

model BreakWindow {
  id        String @id @default(cuid())
  tenantId  String
  name      String // e.g. "Morning Tea"
  startTime String // HH:mm
  endTime   String // HH:mm

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AgentPresence {
  id                String              @id @default(cuid())
  tenantId          String
  userId            String              @unique
  status            AgentPresenceStatus @default(OFFLINE)
  lastActiveAt      DateTime            @default(now())
  currentBreakLabel String?
  breakStartedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

enum AgentPresenceStatus {
  ACTIVE
  BREAK
  INACTIVE
  OFFLINE
  NOT_STARTED
}

model AgentBreakLog {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  label     String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, startedAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String // e.g. "LEAD_ASSIGNED", "TASK_DUE", "WORKFLOW_FAILED"
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
}

// ─── Admissions ATS: Programs & Applications ───────────────────────────────────

model Program {
  id                String   @id @default(cuid())
  tenantId          String
  code              String
  name              String
  degreeLevel       String // UG | PG
  department        String?
  durationMonths    Int?
  intakeCapacity    Int?
  tuitionFeePerYear Decimal? @db.Decimal(15, 2)
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Application {
  id        String            @id @default(cuid())
  tenantId  String
  contactId String
  programId String
  appNumber String
  status    ApplicationStatus @default(SUBMITTED)
  notes     String?

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@unique([tenantId, appNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, programId])
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  OFFERED
  ENROLLED
  REJECTED
}

// ─── Real Estate ──────────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  tenantId        String
  name            String
  developer       String?
  location        String?
  city            String?
  status          ProjectStatus @default(UPCOMING)
  description     String?
  totalUnits      Int?
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  geofenceMeters  Int?          @default(200)
  amenities       Json? // string[], e.g. ["Gym", "Swimming Pool", "Clubhouse"] — used by property-match scoring

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units      Unit[]
  siteVisits SiteVisit[]
  bookings   Booking[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum ProjectStatus {
  UPCOMING
  UNDER_CONSTRUCTION
  READY
  COMPLETED
}

model Unit {
  id         String     @id @default(cuid())
  tenantId   String
  projectId  String
  unitNumber String
  tower      String?
  floor      Int?
  type       String? // e.g. "2BHK", "3BHK", "Villa"
  areaSqft   Decimal?   @db.Decimal(10, 2)
  price      Decimal?   @db.Decimal(15, 2)
  facing     String? // e.g. "North", "East" — used by property-match scoring
  status     UnitStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteVisits SiteVisit[]
  bookings   Booking[]

  @@unique([projectId, unitNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
}

enum UnitStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
}

model SiteVisit {
  id            String          @id @default(cuid())
  tenantId      String
  contactId     String
  projectId     String
  unitId        String?
  agentId       String?
  partnerId     String?
  scheduledAt   DateTime
  status        SiteVisitStatus @default(SCHEDULED)
  statusAt      DateTime        @default(now())
  travelMinutes Int?
  visitMinutes  Int?
  interestLevel InterestLevel?
  rating        Int?
  feedback      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact  @relation(fields: [contactId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  agent   User?    @relation("SiteVisitAgent", fields: [agentId], references: [id], onDelete: SetNull)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, agentId])
  @@index([tenantId, partnerId])
  @@index([tenantId, contactId])
  @@index([tenantId, projectId])
}

enum SiteVisitStatus {
  SCHEDULED
  ON_THE_WAY
  AT_SITE
  VISITING
  VISIT_DONE
  RETURNING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
}

model Booking {
  id                 String        @id @default(cuid())
  tenantId           String
  contactId          String
  projectId          String
  unitId             String
  agentId            String?
  partnerId          String?
  bookingAmount      Decimal?      @db.Decimal(15, 2)
  totalAmount        Decimal?      @db.Decimal(15, 2)
  status             BookingStatus @default(TOKEN_RECEIVED)
  brokeragePercent   Decimal?      @db.Decimal(5, 2)
  brokerageAmount    Decimal?      @db.Decimal(15, 2)
  brokerageReceived  Decimal       @default(0) @db.Decimal(15, 2)
  bookingDate        DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact  @relation(fields: [contactId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  unit    Unit     @relation(fields: [unitId], references: [id])
  agent   User?    @relation("BookingAgent", fields: [agentId], references: [id], onDelete: SetNull)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, agentId])
  @@index([tenantId, partnerId])
  @@index([tenantId, contactId])
  @@index([tenantId, projectId])
}

enum BookingStatus {
  TOKEN_RECEIVED
  BOOKED
  AGREEMENT_DONE
  REGISTERED
  CANCELLED
}

model PropertyPreference {
  id             String   @id @default(cuid())
  tenantId       String
  contactId      String   @unique
  preferredCity  String?
  preferredType  String? // e.g. "2BHK", "3BHK", "Villa"
  budgetMin      Decimal? @db.Decimal(15, 2)
  budgetMax      Decimal? @db.Decimal(15, 2)
  preferredFloor Int?
  facing         String? // e.g. "North", "East"
  amenities      Json? // string[], desired amenities — scored against Project.amenities
  commutePreference String? // free text for now, e.g. "near metro"
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Real-estate-specific lead funnel. Kept separate from the CRM-generic Contact.status
// (LEAD/PROSPECT/CUSTOMER/...) and from Deal.stageId (a tenant-configurable pipeline) —
// this is a fixed funnel meaningful only to the real estate vertical.
enum RealEstateLeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPERTY_SHARED
  VISIT_SCHEDULED
  VISIT_DONE
  NEGOTIATION
  BOOKING
  CLOSED_WON
  CLOSED_LOST
}

// Audit trail of realEstateStage changes, mirroring AuditLog's before/after style
// but scoped to just this one funnel so it's cheap to query per-contact.
model RealEstateStageHistory {
  id          String               @id @default(cuid())
  tenantId    String
  contactId   String
  fromStage   RealEstateLeadStage?
  toStage     RealEstateLeadStage
  changedAt   DateTime             @default(now())
  triggeredBy String // e.g. "SITE_VISIT_CREATED", "BOOKING_REGISTERED", or a userId for manual changes

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, contactId])
}

// External channel partner / broker who sources or co-sells leads — distinct from
// `agentId` (an internal CRM User) on SiteVisit/Booking. A visit or booking may come
// from an internal agent, an external partner, both, or neither.
model Partner {
  id                String            @id @default(cuid())
  tenantId          String
  name              String
  phone             String?
  email             String?
  kycStatus         PartnerKycStatus  @default(PENDING)
  commissionPercent Decimal?          @db.Decimal(5, 2)
  isActive          Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteVisits SiteVisit[]
  bookings   Booking[]

  @@index([tenantId])
}

enum PartnerKycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Roles & Permissions ────────────────────────────────────────────────────

model RolePermission {
  id                  String   @id @default(cuid())
  tenantId            String
  role                UserRole
  // { "leads": {"view": true, "edit": true}, "campaigns": {...}, ... }
  permissions         Json     @default("{}")
  // restricts MANAGER/AGENT visibility to only their own team's leads/reports
  managerScopedAccess Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
  @@index([tenantId])
}
