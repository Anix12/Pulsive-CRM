# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_saas
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/crm_saas

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# ─── Twilio ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ─── AWS ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=crm-saas-recordings

# ─── Email (AWS SES) ─────────────────────────────────────────────
SES_FROM_EMAIL=noreply@yourapp.com
SES_FROM_NAME=CRM Platform

# ─── Payments ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ─── Sentry ──────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── AI (Claude) ─────────────────────────────────────────────────
# Used for AI-drafted email copy in Templates. Leave unset to disable.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ─── Super Admin ─────────────────────────────────────────────────
SUPER_ADMIN_JWT_SECRET=change-me-super-admin-secret-32-chars





